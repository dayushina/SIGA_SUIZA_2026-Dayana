# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# PostgreSQL local (pgAdmin) = fuente de verdad de los datos.
# "host.docker.internal" es el hostname que Docker Desktop usa para
# alcanzar el host desde dentro de un contenedor.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_local

# Clave HS256 compartida por el Core y los modulos para firmar/validar JWT.
# OBLIGATORIA (minimo 32 caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En Railway definila como variable del servicio. NUNCA la versiones.
SECRET_KEY=

# ------------------------------------------------------------
# Solo PRODUCCION (Railway). start_railway.sh fija por defecto
# ENVIRONMENT=production, DEBUG=false y ENABLE_NATS=false.
# Con ENVIRONMENT=production NO se crean las cuentas de prueba:
# si la BD no tiene usuarios se crea un unico superadmin con estos
# datos, y el Core no arranca si SIGA_ADMIN_PASSWORD falta o es
# debil (<12 caracteres). Si la BD ya tiene usuarios, se ignoran.
# ------------------------------------------------------------
# SIGA_ADMIN_EMAIL=admin@siga.edu
# SIGA_ADMIN_PASSWORD=

# ------------------------------------------------------------
# Snapshot cifrado de la BD para Railway (ver docs/DEPLOY-RAILWAY.md).
# Lo genera siga_backend/tools/export_seed.py (si falta, crea la clave
# y la agrega a .env). Copiala tal cual a las Variables de Railway.
# ------------------------------------------------------------
# SIGA_SEED_KEY=
# SIGA_SEED_MODE=auto   # auto | replace | skip
