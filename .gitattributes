# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows-specific files (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Snapshot cifrado de la BD: binario opaco (sin diffs ni conversion de EOL)
*.enc binary
